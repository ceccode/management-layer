# LLM API (optional - if missing, the report carries no analysis)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Reddit API (optional - if missing, Reddit is skipped)
# New apps need Reddit's approval first (Responsible Builder Policy): request API access,
# then create a "script" app at https://www.reddit.com/prefs/apps and copy its id and secret.
# Only the app authenticates: no Reddit username or password is needed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
